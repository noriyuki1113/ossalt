# VPS 並行稼働フェーズ用 .env（staging.ossalt.jp）
# このファイルをコピーして実際の値を入力:
#   cp .env.vps.staging.example .env.vps.staging
#
# secrets_gen.py が生成した ANON_KEY を使用すること

# VPS 自己ホスト Supabase の API URL
VITE_SUPABASE_URL=https://api.ossalt.jp

# secrets_gen.py の出力から ANON_KEY をコピー
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# OGP 画像生成サービス（VPS上で動かしている場合）
VITE_OG_SERVICE_URL=http://162.43.50.241/og

# サイトURL（staging 用）
VITE_SITE_URL=https://staging.ossalt.jp
