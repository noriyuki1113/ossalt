# BTC Polymarket ペーパートレーダー — 環境変数設定
#
# このファイルを .env にコピーして、各値を設定してください:
#   cp .env.example .env

# ─── 必須 ────────────────────────────────────────────────────
# Anthropic API キー（Claude を使う）
# https://console.anthropic.com/account/keys で取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── 任意（デフォルト値あり）────────────────────────────────
# Polymarket Gamma API ベース URL
# GAMMA_API=https://gamma-api.polymarket.com

# Binance API ベース URL（BTC価格取得）
# BINANCE_API=https://api.binance.com/api/v3

# チェック間隔（秒）デフォルト 300（5分）
# CHECK_INTERVAL_SEC=300

# 初期仮想残高（ドル）
# INITIAL_BALANCE=1000

# 1トレードあたりのベット額（ドル）
# BET_SIZE=10
