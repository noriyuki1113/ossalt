# Copy to .env locally, or set these in your deployment environment.
# Replace placeholders with the correct Supabase URLs and anon/publishable keys.
# The original file had two different Supabase projects; do not assume these are the same.
SUPABASE_URL=https://YOUR_BACKEND_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_BACKEND_SUPABASE_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_FRONTEND_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_FRONTEND_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR_FRONTEND_PROJECT_REF.supabase.co
